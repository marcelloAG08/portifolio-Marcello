programa {
  funcao inicio() {
       inteiro A
        inteiro B
        inteiro C

        escreva("Lua A: ")
        leia(A)

        escreva("Lua B: ")
        leia(B)

        escreva("Lua C: ")
        leia(C)

        se(A == B e B == C)
        {
            escreva("Eclipse Total")
        }
        senao se(A == B ou A == C ou B == C)
        {
            escreva("Parcial")
        }
        senao
        {
            escreva("Dispersao")
        }
    }
}
  }
}
