programa {
  funcao inicio() {
    real x
        real y

        escreva("Salto do Saltitao: ")
        leia(x)

        escreva("Salto do Pula-Pula: ")
        leia(y)

        se(x > y)
        {
            escreva("Saltitao")
        }
        senao
        {
            escreva("Pula-Pula")
        }
    }
}
  }
}
