programa {
  funcao inicio() {
      real distancia
        real litros
        real consumo

        escreva("Distancia percorrida (km): ")
        leia(distancia)

        escreva("Combustivel gasto (litros): ")
        leia(litros)

        consumo = distancia / litros

        escreva("Consumo medio: ", consumo, " km/l")
    }
}
  }
}
