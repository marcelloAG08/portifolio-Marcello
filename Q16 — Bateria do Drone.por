programa {
  funcao inicio() {
    inteiro bat

        escreva("Porcentagem da bateria: ")
        leia(bat)

        se(bat > 20)
        {
            escreva("A voar")
        }
        senao se(bat >= 1)
        {
            escreva("Aterragem de emergencia")
        }
        senao
        {
            escreva("Desativado")
        }
    }
}
  }
}
