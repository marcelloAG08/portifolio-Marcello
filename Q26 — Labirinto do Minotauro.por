programa {
  funcao inicio() {
    caractere c1
        caractere c2

        escreva("Primeira direcao (N,S,E,O): ")
        leia(c1)

        escreva("Segunda direcao (N,S,E,O): ")
        leia(c2)

        se(c1 == 'N' e c2 == 'O')
        {
            escreva("Saida")
        }
        senao
        {
            escreva("Minotauro")
        }
    }
}
  }
}
